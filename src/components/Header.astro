---
import { NAV, SITE } from '../lib/site.js';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => path === href.replace(/\/+$/, '');
---
<header class="site-header sticky top-0 z-50 border-b border-warm/70 bg-surface/90 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a href="/" class="group flex items-center gap-2" aria-label={`${SITE.name} home`}>
      <img
        src="/images/cashiko-icon.svg"
        alt=""
        width="444"
        height="246"
        class="h-8 w-auto transition-transform duration-150 group-hover:-translate-y-0.5"
      />
      <span class="font-display text-[1.35rem] font-semibold tracking-tight text-forest-dark">CashIko</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'nav-link text-[0.8125rem] font-medium transition-colors duration-150 hover:text-forest-dark',
            isActive(item.href) ? 'text-forest-dark' : 'text-forest-muted',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href="/contact/" class="text-[0.8125rem] font-medium text-forest-muted transition-colors hover:text-forest-dark">Contact</a>
      <a
        href={SITE.appUrl}
        class="rounded-lg bg-forest px-4 py-2 text-[0.8125rem] font-semibold text-white transition-colors duration-150 hover:bg-forest-dark active:scale-[0.98]"
      >
        Start free trial
      </a>
    </div>

    <!-- Mobile: <details> keeps the menu working without JavaScript. -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-warm/80 text-forest-dark transition-colors hover:bg-cream [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-[17rem] overflow-hidden rounded-xl border border-warm bg-white shadow-lift">
        <nav class="flex flex-col p-2" aria-label="Mobile">
          {NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                isActive(item.href) ? 'bg-cream text-forest-dark' : 'text-forest-muted hover:bg-cream hover:text-forest-dark',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a href="/contact/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-forest-muted hover:bg-cream hover:text-forest-dark">Contact</a>
        </nav>
        <div class="border-t border-warm/70 p-3">
          <a
            href={SITE.appUrl}
            class="block rounded-lg bg-forest px-3 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-forest-dark"
          >
            Start free trial
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
