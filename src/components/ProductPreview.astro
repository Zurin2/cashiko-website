---
/**
 * Hand-built preview of the dashboard (HTML + CSS, not a screenshot).
 * Numbers are illustrative and labelled as such.
 *
 * Motion hooks: the wrapper gets [data-hero-card] from the page, the bars
 * grow on load, and the recorded-sale toast springs in last.
 */
const days = [
  { label: 'W', h: 46 },
  { label: 'T', h: 62 },
  { label: 'F', h: 38 },
  { label: 'S', h: 84 },
  { label: 'S', h: 96 },
  { label: 'M', h: 58 },
  { label: 'T', h: 72 },
];

const lowStock = [
  { name: 'Brown sugar 500g', meta: 'Out of stock', out: true },
  { name: 'Cooking oil 1L', meta: '2 left', out: false },
  { name: 'Pandesal bundle', meta: '5 left', out: false },
];
---
<figure>
  <div class="relative">
    <div class="overflow-hidden rounded-2xl border border-warm bg-white shadow-lift">
      <!-- window bar -->
      <div class="flex items-center justify-between border-b border-warm/70 px-5 py-3">
        <div class="flex items-center gap-2.5">
          <img src="/images/cashiko-icon.svg" alt="" width="444" height="246" class="h-5 w-auto" />
          <span class="text-[0.8125rem] font-semibold text-forest-dark">CashIko</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="rounded-md bg-cream px-2 py-1 text-[10px] font-semibold text-forest-muted">Main branch</span>
          <span class="grid h-6 w-6 place-items-center rounded-full bg-mango/15 text-[10px] font-bold text-mango-dark">N</span>
        </div>
      </div>

      <!-- today -->
      <div class="px-5 pb-4 pt-5">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-forest-muted">Sales today</p>
            <p class="tabular mt-1 font-display text-[2.1rem] leading-none text-forest-dark">
              <span data-count="2415" data-count-decimals="2" data-count-prefix="₱">₱2,415.00</span>
            </p>
          </div>
          <span class="rounded-md bg-forest-soft px-2 py-1 text-[10px] font-semibold text-forest">38 sales</span>
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-2">
          <div class="rounded-lg bg-cream/70 px-2.5 py-2">
            <dt class="text-[10px] font-medium text-forest-muted">Profit</dt>
            <dd class="tabular text-[0.8125rem] font-bold text-forest-dark">
              <span data-count="895" data-count-decimals="2" data-count-prefix="₱" data-count-duration="1400">₱895.00</span>
            </dd>
          </div>
          <div class="rounded-lg bg-cream/70 px-2.5 py-2">
            <dt class="text-[10px] font-medium text-forest-muted">Expenses</dt>
            <dd class="tabular text-[0.8125rem] font-bold text-forest-dark">₱340.00</dd>
          </div>
          <div class="rounded-lg bg-mango-soft px-2.5 py-2">
            <dt class="text-[10px] font-medium text-mango-dark">Utang</dt>
            <dd class="tabular text-[0.8125rem] font-bold text-mango-dark">
              <span data-count="1420" data-count-prefix="₱" data-count-duration="1400">₱1,420</span>
            </dd>
          </div>
        </dl>
      </div>

      <!-- week bars -->
      <div class="border-t border-warm/60 px-5 py-4">
        <div class="flex items-baseline justify-between">
          <p class="text-[11px] font-semibold text-forest-dark">Last 7 days</p>
          <p class="text-[10px] text-forest-muted">₱14,820 total</p>
        </div>

        <div class="mt-3 flex h-16 items-end gap-1.5" aria-hidden="true">
          {days.map((day, index) => (
            <div class="flex h-full flex-1 items-end">
              <div
                data-bar
                class:list={[
                  'w-full rounded-sm',
                  index === days.length - 1 ? 'bg-mango' : 'bg-forest/25',
                ]}
                style={`height:${day.h}%; --i:${index}`}
              ></div>
            </div>
          ))}
        </div>
        <div class="mt-1.5 flex gap-1.5" aria-hidden="true">
          {days.map((day) => (
            <span class="flex-1 text-center text-[9px] text-forest-muted/70">{day.label}</span>
          ))}
        </div>
      </div>

      <!-- low stock -->
      <div class="border-t border-warm/60 bg-cream/40 px-5 py-4">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold text-forest-dark">Low stock</p>
          <p class="text-[10px] text-forest-muted">3 items</p>
        </div>
        <ul class="mt-2.5 divide-y divide-warm/50">
          {lowStock.map((item) => (
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="truncate text-[11px] font-medium text-forest-dark">{item.name}</span>
              <span
                class:list={[
                  'shrink-0 rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide',
                  item.out ? 'bg-red-100 text-red-700' : 'bg-mango-soft text-mango-dark',
                ]}
              >
                {item.meta}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- recorded-sale toast: the 3-tap flow, made visible -->
    <div
      class="absolute -bottom-9 left-4 hidden w-[15.5rem] rounded-xl border border-warm bg-white p-3 shadow-lift sm:block md:-left-8"
      data-hero-toast
    >
      <div class="flex items-center gap-2.5">
        <span class="grid h-7 w-7 place-items-center rounded-full bg-forest text-white">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6.2 4.6 8.8 10 3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-[11px] font-semibold text-forest-dark">Sale recorded · GCash</p>
          <p class="tabular text-[10px] text-forest-muted">2× Coke 1.5L — ₱150.00</p>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="mt-6 text-[11px] text-forest-muted/80 sm:mt-20">
    Illustrative data. Your dashboard will show your own numbers.
  </figcaption>
</figure>
